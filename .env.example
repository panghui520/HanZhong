# ============================================================
# 汉游智脑 环境变量样例
# 用法：复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，绝不入库。
# ============================================================

# ---------- 城市数据包 ----------
# 换成别的城市只需改这里，并把 citypack/<CITY_PACK>/ 目录准备好
CITY_PACK=hanzhong

# ---------- LLM（OpenAI 兼容接口）----------
# 支持 DeepSeek / 通义 / Kimi / 本地 Ollama 等任一 OpenAI 兼容端点
LLM_API_KEY=sk-xxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_EMBEDDING_MODEL=
# 演示模式：true 时全部走预生成缓存，断网也能完整演示
DEMO_MODE=false

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=hanyou
MYSQL_USER=root
MYSQL_PASSWORD=change_me

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- 服务端口 ----------
JAVA_SERVER_PORT=8080
AI_SERVER_PORT=8000
WEB_PORT=5173

# ---------- 内部服务鉴权 ----------
# Java <-> Python 之间的固定头，两个服务配置必须一致
INTERNAL_TOKEN=change_me_internal_token
