# ============================================================
# 汉游智脑 环境变量样例
# 用法：复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，绝不入库。
#
# ⚠️ 这个文件**只被 Python（server-ai）读取**（config.py 里的 python-dotenv）。
#    Java 侧不读 .env：pom.xml 里没有 dotenv 依赖，application.yml 全是
#    ${VAR:默认值}，读的是**系统环境变量**。两边默认值目前一致所以能跑通，
#    但你在 .env 里改 INTERNAL_TOKEN / MYSQL_* 时 Java 不会跟着变。
#    最典型的事故：改了 .env 的 INTERNAL_TOKEN → Python 用新值、Java 用默认值
#    → 两边不一致 → /api/ai/** 全部返回 3001。要改就两边都设成系统环境变量。
# ============================================================

# ---------- 城市数据包 ----------
# 换成别的城市只需改这里，并把 citypack/<CITY_PACK>/ 目录准备好
CITY_PACK=hanzhong

# ---------- LLM（对话生成，OpenAI 兼容接口）----------
# 支持 DeepSeek / 通义 / Kimi / 本地 Ollama 等任一 OpenAI 兼容端点
LLM_API_KEY=sk-xxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 单次生成的整体超时（秒）。流式回答耗时长，给足
LLM_TIMEOUT_S=60
# 演示模式：true 时全部走预生成缓存，断网也能完整演示
DEMO_MODE=false

# ---------- Embedding（向量化，与对话模型分开配）----------
# 为什么要分开：DeepSeek 官方只提供 chat/completions，**没有 /embeddings 端点**。
# 若沿用 LLM_BASE_URL + LLM_API_KEY，嵌入请求会打到
# https://api.deepseek.com/v1/embeddings 上返回 404。
# 本项目对话用 DeepSeek、嵌入用硅基流动的 BAAI/bge-m3，两套凭证各自独立。
#
# LLM_EMBEDDING_MODEL 留空 → 用内置的离线字符 n-gram 向量（不联网、无模型文件、可断网演示）。
# 填了**且**配了 LLM_EMBEDDING_API_KEY → 调厂商接口，此时必须重跑 build_kb.py 重建索引。
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 知识库（M3）----------
# 向量库落盘位置。它是构建产物，已加入 .gitignore，换机器要重跑 scripts/build_kb.py
VECTORSTORE_DIR=data/vectorstore
# 检索返回的候选条数，最终取前几条进上下文
RAG_TOP_K=5
# 预生成答案缓存。断网演示时的兜底，随仓库提交
QA_CACHE_FILE=server-ai/cache/qa_demo.json

# ---------- 数据库 ----------
# 注意：Python 侧**不连业务库**（AI 服务是无状态的，业务数据一律经 Java 代理），
# 这几项只有 Java 用，而 Java 不读 .env。留在这里是给人看的口径说明。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=hanyou_brain
MYSQL_USER=root
MYSQL_PASSWORD=1234

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- 服务端口 ----------
JAVA_SERVER_PORT=8080
AI_SERVER_PORT=8000
WEB_PORT=5173

# ---------- 内部服务鉴权 ----------
# Java <-> Python 之间的固定头，两个服务配置必须一致。
# 改了一处要同时改另一处，否则 /api/ai/** 会全部返回 3001。
INTERNAL_TOKEN=change_me_internal_token

# ---------- Java 侧访问 AI 服务 ----------
# 总开关。关掉后 /api/ai/** 返回 3002，业务接口不受影响
AI_ENABLED=true
# Python 只监听回环地址，外部流量一律经 Java 代理
AI_BASE_URL=http://127.0.0.1:8000
